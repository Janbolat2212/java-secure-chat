{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "1. Build and test",
      "type": "shell",
      "command": "./mvnw",
      "windows": {"command": ".\\mvnw.cmd"},
      "args": ["-B", "-ntp", "verify"],
      "group": {"kind": "build", "isDefault": true},
      "problemMatcher": ["$javac"]
    },
    {
      "label": "2. Run demo",
      "type": "process",
      "command": "java",
      "args": ["-Dfile.encoding=UTF-8", "-jar", "target/secure-chat.jar", "demo"],
      "dependsOn": "1. Build and test",
      "problemMatcher": []
    }
  ]
}
